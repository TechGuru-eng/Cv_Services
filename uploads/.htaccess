# No script execution, no directory listing
Options -Indexes -ExecCGI
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|shtml|cgi|pl|py|sh|html?|svg|js)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
