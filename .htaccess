# Force UTF-8 Encoding
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .php .js .css .json
AddType "text/html; charset=UTF-8" .html

# 1. Enable Rewriting
Options +FollowSymLinks -MultiViews
RewriteEngine On
DirectoryIndex index.html index.php

# 1.5 Block sensitive paths (VCS, deps, configs, dumps, private ops scripts)
RewriteRule (^|/)\.(git|svn|env|htpasswd|DS_Store) - [F,L,NC]
RewriteRule ^(_ops|node_modules|scratch|tmp|PHPMailer|premium-ebook-page)(/|$) - [F,L,NC]
RewriteRule ^admin/(config|sql|includes)(/|$) - [F,L,NC]
RewriteCond %{REQUEST_URI} !(^|/)robots\.txt$
RewriteRule \.(sql|md|txt|bak|log|zip|lock|ini|sh|yml|yaml)$ - [F,L,NC]
RewriteRule ^(package(-lock)?\.json|tailwind\.config\.js|input\.css|promos_.*\.json|prospect_cols\.json)$ - [F,L,NC]

# 2. Force HTTPS (Optional but recommended for deployment)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !=localhost
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2.5 URL Shortener Router Rewrite
RewriteRule ^r/([a-zA-Z0-9]+)$ r.php?c=$1 [L,QSA]

# 2.6 Blog CMS Rewrite (e.g., /blog/comment-reussir-son-cv -> article.php?slug=comment-reussir-son-cv)
RewriteRule ^blog/([a-zA-Z0-9-]+)$ article.php?slug=$1 [L,QSA]

# 2.7 LinkedIn Service Routes
RewriteRule ^linkedin/?$ linkedin/index.php [L,QSA]
RewriteRule ^linkedin/commander/?$ linkedin/commander.php [L,QSA]
RewriteRule ^linkedin/diagnostic/?$ linkedin/diagnostic.php [L,QSA]
RewriteRule ^suivi-linkedin/?$ linkedin/suivi.php [L,QSA]
RewriteRule ^linkedin/suivi-linkedin/?$ linkedin/suivi.php [L,QSA]
RewriteRule ^linkedin/suivi/?$ linkedin/suivi.php [L,QSA]
RewriteRule ^linkedin/commande/([a-zA-Z0-9-]+)$ linkedin/commande.php?ref=$1 [L,QSA]
RewriteRule ^admin/linkedin/?$ admin/linkedin/index.php [L,QSA]
RewriteRule ^admin/linkedin/commandes/?$ admin/linkedin/commandes.php [L,QSA]
RewriteRule ^admin/linkedin/commandes/([a-zA-Z0-9-]+)$ admin/linkedin/order_details.php?id=$1 [L,QSA]
RewriteRule ^admin/linkedin/packages/?$ admin/linkedin/packages.php [L,QSA]
RewriteRule ^admin/linkedin/parametres/?$ admin/linkedin/parametres.php [L,QSA]

# 3. Canonicalize: Remove .php extension (Redirect /file.php to /file)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 4. Handle Root URL
RewriteRule ^$ index.html [NC,L]

# 5. Handle Extension-less URLs (Internal Rewrite /file to /file.html or .php)
# If the request is not a directory
RewriteCond %{REQUEST_FILENAME} !-d
# And the file.html exists, rewrite to .html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L,QSA]

# If the request is not a directory
RewriteCond %{REQUEST_FILENAME} !-d
# And the file.php exists, rewrite to .php
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L,QSA]



# 5. Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header unset X-Powered-By
</IfModule>
# PHP hardening (only applied when PHP runs as an Apache module; otherwise set in php.ini)
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag expose_php off
    php_flag session.cookie_httponly on
    php_flag session.use_strict_mode on
    php_value session.cookie_samesite Lax
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors off
    php_flag expose_php off
    php_flag session.cookie_httponly on
    php_flag session.use_strict_mode on
    php_value session.cookie_samesite Lax
</IfModule>

# 6. Cache Control: HTML/PHP never cached; static assets cached
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresDefault "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>

# 7. Custom Error Pages
ErrorDocument 400 /error.php
ErrorDocument 401 /error.php
ErrorDocument 403 /error.php
ErrorDocument 404 /error.php
ErrorDocument 500 /error.php
